rules_version = '2';
// All Firestore access in this app goes through the Firebase Admin SDK on the
// server (which bypasses these rules). The client SDK is used only for Auth.
// Deny all direct client reads/writes to prevent unauthorized access via the
// public Firebase config.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
