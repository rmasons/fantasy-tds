# Firebase client-side config (safe to expose — these are public keys)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK service account (keep secret — server-side only)
# Paste the entire JSON from Firebase Console > Project Settings > Service Accounts as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Vercel cron secret — set this in Vercel dashboard > Environment Variables
# Vercel injects CRON_SECRET automatically; add it here for local testing
CRON_SECRET=

# Contentful blog (optional — blog page is disabled if these are not set)
# Get these from Contentful > Space Settings > API Keys
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
# Contentful Management API token — required for blog comments (write access)
# Get from Contentful > Settings > API Keys > Content management tokens
CONTENTFUL_MANAGEMENT_TOKEN=
